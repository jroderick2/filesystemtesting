universe = vanilla
+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/coffeateam/coffea-dask-almalinux9:2025.12.0-py3.12"
+SingularityExtraArgs = "-B /cvmfs -B /etc/grid-security"
transfer_input_files = replay.py, ./xrdlogs/$(XrdLog), ./rootfile_lists/testfile.txt, rtest.tkn, libjemalloc.so.2

Executable = replay.py
Arguments = -i $(XrdLog) -r testfile.txt -n -u 60 -w 12 -j 1 -o $(Process) 
# make sure to mkdir -p logs before submitting the job!
Output = condor_logs/replay.$(Cluster).$(Process).stdout
Error = condor_logs/replay.$(Cluster).$(Process).stderr
Log = condor_logs/replay.$(Cluster).$(Process).log
should_transfer_files = YES
WhenToTransferOutput  = ON_EXIT_OR_EVICT
RequestCpus = 1
environment = "BEARER_TOKEN_FILE=rtest.tkn TEST_CLIENT= TEST_SECRET= LD_PRELOAD=./libjemalloc.so.2"
RequestMemory = 6000



queue XrdLog from xrdlogs_list.txt

